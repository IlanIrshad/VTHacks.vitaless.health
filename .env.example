# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Google Gemini (AI companion brain) ---
# Get a key at https://ai.google.dev/
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash (confirmed current as of 2026-09-19;
# gemini-2.5-flash and earlier have been retired). Check
# https://ai.google.dev/gemini-api/docs/models for the current lineup if this
# default has since been deprecated.
GEMINI_MODEL=gemini-3.6-flash

# --- ElevenLabs (companion voice / narrated routines) ---
# Get a key at https://elevenlabs.io/ — use the VTHacks sponsor promo code if provided at check-in.
ELEVENLABS_API_KEY=
# Pick any voice ID from your ElevenLabs voice library (default below is a stock ElevenLabs voice).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Presage (Human Sensing Layer — biometric vitals/emotion/focus) ---
# Presage's public SDKs are iOS / Android / C++; there is no browser SDK.
# For a web app, record a short webcam clip client-side and send it to our
# /api/biometrics route, which forwards it to Presage's Physiology API.
# Sign up at https://www.presagetech.com/ (MLH partner page: https://www.mlh.com/partners/presage)
# Base URL + contract confirmed 2026-09-19 by inspecting the official
# `Presage-Technologies` PyPI package and testing live: auth is the
# `x-api-key` header (not Authorization: Bearer), and only the /v2/* upload
# endpoints are actually deployed — see the comment at the top of
# src/lib/presage.ts for the full confirmed request/response shapes.
PRESAGE_API_KEY=
PRESAGE_API_BASE_URL=https://api.physiology.presagetech.com

# --- Tiger Data / TimescaleDB (biometric time-series storage) ---
# Free tier: https://www.tigerdata.com/ — grab the connection string from your service.
# NOTE: recent `pg` treats a bare sslmode=require as full CA-verified TLS,
# which fails against Tiger Data's cert chain. src/lib/db.ts and
# scripts/init-db.js both append uselibpqcompat=true automatically, so you
# don't need to add it to the string yourself.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- MongoDB Atlas (user accounts, chat history, preferences) ---
# Free tier: https://www.mongodb.com/cloud/atlas — grab the connection string
# from your cluster's "Connect > Drivers" panel. Sign-in is fully optional:
# the app works anonymously without this, it just won't persist accounts.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Any long random string, used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Resend (real email for check-in reminders) ---
# Free tier: https://resend.com/ — create an API key, no domain
# verification needed if you send from their shared onboarding@resend.dev
# address (the default below). Verify your own domain there later if you
# want to send from a vitaless.health address instead.
RESEND_API_KEY=
EMAIL_FROM=Vitaless <onboarding@resend.dev>
# Any long random string — protects POST /api/reminders/send (the batch
# job that emails everyone with "Email me a check-in reminder" on) from
# being triggered by anyone but your own cron job. Generate one the same
# way as SESSION_SECRET above.
REMINDER_CRON_SECRET=
